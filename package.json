{
  "name": "yogurt",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vite --config infra/vite.config.ts",
    "test": "vitest run --config infra/vitest.config.ts",
    "build:dev": "CLOUDFLARE_ENV=dev vite build --config infra/vite.config.ts",
    "build:main": "CLOUDFLARE_ENV=production vite build --config infra/vite.config.ts",
    "deploy:dev": "pnpm run build:dev && wrangler deploy --config src/ui/dist/yogurt_dev/wrangler.json",
    "deploy:main": "pnpm run build:main && wrangler deploy --config src/ui/dist/yogurt/wrangler.json",
    "secret:dev": "wrangler secret put --config infra/wrangler.jsonc --env dev",
    "secret:main": "wrangler secret put --config infra/wrangler.jsonc --env production",
    "keygen:session": "node src/infra/cli/keygen.ts",
    "keygen:account": "node src/infra/cli/account-keygen.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to src/ui/.wrangler/state --config infra/wrangler.jsonc --env dev",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --config infra/wrangler.jsonc --env dev",
    "db:migrate:main": "wrangler d1 migrations apply DB --remote --config infra/wrangler.jsonc --env production",
    "verify": "pnpm -s test && pnpm -s check && PYTHONDONTWRITEBYTECODE=1 python3 .agents/skills/yogurt-module-check/scripts/app/check.py --root .",
    "check": "tsc --noEmit",
    "secret:setup": "node src/infra/cli/secret-setup-cli.ts",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "ky": "^2.2.0",
    "lucide-react": "^1.61.0",
    "paseto": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
