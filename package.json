{
  "name": "yogurt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vite --config infra/vite.config.ts",
    "test": "vitest run --config infra/vitest.config.ts",
    "build:dev": "CLOUDFLARE_ENV=dev vite build --config infra/vite.config.ts",
    "build:main": "CLOUDFLARE_ENV=production vite build --config infra/vite.config.ts",
    "deploy:dev": "pnpm run build:dev && wrangler deploy --config src/ui/dist/yogurt_dev/wrangler.json",
    "deploy:main": "pnpm run build:main && wrangler deploy --config src/ui/dist/yogurt/wrangler.json",
    "secret:dev": "wrangler secret put --config infra/wrangler.jsonc --env dev",
    "secret:main": "wrangler secret put --config infra/wrangler.jsonc --env production",
    "keygen:session": "node src/infra/keygen.ts",
    "check": "tsc --noEmit",
    "secret:setup": "node src/infra/secret-setup-cli.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "paseto": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
