{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "main": "../src/infra/worker.ts",
  "compatibility_date": "2026-10-19",
  "env": {
    "dev": {
      "name": "yogurt-dev",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "production": {
      "name": "yogurt",
      "workers_dev": true,
      "routes": [{ "pattern": "yogurt.qus0in.dev", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
